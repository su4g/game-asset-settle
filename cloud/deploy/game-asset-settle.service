[Unit]
Description=Game Asset Settle private snapshot API
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=game-asset-settle
Group=game-asset-settle
WorkingDirectory=/opt/game-asset-settle/current
ExecStart=/usr/bin/node --max-old-space-size=512 /opt/game-asset-settle/current/cloud/index.cjs /etc/game-asset-settle/cloud.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Environment=NODE_ENV=production
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=768M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
